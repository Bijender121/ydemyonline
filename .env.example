# Clerk (https://dashboard.clerk.com). Only NEXT_PUBLIC_* values reach the browser.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Sanity (https://www.sanity.io/manage). Project id and dataset are client safe.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-29
# Server only: Viewer token for the private dataset. Never prefix with NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=
# Server only: secret shared with the Sanity webhook that calls /api/revalidate.
SANITY_REVALIDATE_SECRET=
